# Normalize text files to LF in the repository.
* text=auto eol=lf

# Windows-specific scripts keep CRLF in the working tree.
*.bat text eol=crlf
*.ps1 text eol=crlf
*.cmd text eol=crlf

# Shell / Python / Odin sources.
*.sh  text eol=lf
*.py  text eol=lf
*.odin text
*.md  text
*.csv text eol=lf

# Prebuilt binaries (Z3 C SDK) are not line-diffable.
*.dll binary
*.lib binary
*.exe binary
*.pdb binary
